{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "networks": {
        "type": "object",
        "patternProperties": {
          "^\\w+$": {
            "type": "object",
            "properties": {
              "nodeURL": { "type": "string" },
              "maxLRUCacheInstances": { "type": "string" },
              "utxosLimit": { "type": "string" },
              "defaultSlippage": { "type": "string" }
            },
            "required": ["nodeURL", "maxLRUCacheInstances", "utxosLimit", "defaultSlippage"],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "required": ["networks"],
    "additionalProperties": false
  }